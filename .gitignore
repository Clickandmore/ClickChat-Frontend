# This repository publishes the marketing-site prototypes (Navy Canvas, and on this branch Direction 4.1 "Living Universe").
# Everything in the working folder is ignored unless it is listed below (the prototype and the shared files it loads).
/*
!/.gitignore
!/README.md

# the prototype
!/prototypes/
/prototypes/*
!/prototypes/experiments/
/prototypes/experiments/*
!/prototypes/experiments/navy-canvas/
/prototypes/experiments/navy-canvas/_backup/

# Direction 4.1 "Living Universe" (single page)
!/prototypes/direction-4-1-living-universe.html

# shared files the prototype loads: fonts, base styles, icons, sector photos (JPG only), channel logos
!/prototypes/assets/
/prototypes/assets/*
!/prototypes/assets/brand-fonts.css
!/prototypes/assets/base.css
!/prototypes/assets/icons.js
!/prototypes/assets/logos/
!/prototypes/assets/photos/
/prototypes/assets/photos/*.png
# files Direction 4.1 loads: the 3D hero icon scene, the Tailwind config and the hero posters
!/prototypes/assets/hero-icon-scene.js
!/prototypes/assets/tailwind-config.js
!/prototypes/assets/universe-logo-poster-desktop.jpg
!/prototypes/assets/universe-logo-poster-mobile.jpg

# brand kit: only the SVG logos, the favicon and the patterns the pages reference
!/ClickChat-Brand-Identity/
/ClickChat-Brand-Identity/*
!/ClickChat-Brand-Identity/ClickChat-Brand-Identity/
/ClickChat-Brand-Identity/ClickChat-Brand-Identity/*
!/ClickChat-Brand-Identity/ClickChat-Brand-Identity/01-Logo/
/ClickChat-Brand-Identity/ClickChat-Brand-Identity/01-Logo/*/*
!/ClickChat-Brand-Identity/ClickChat-Brand-Identity/01-Logo/*/SVG/
!/ClickChat-Brand-Identity/ClickChat-Brand-Identity/02-App-Icons-and-Favicons/
/ClickChat-Brand-Identity/ClickChat-Brand-Identity/02-App-Icons-and-Favicons/*
!/ClickChat-Brand-Identity/ClickChat-Brand-Identity/02-App-Icons-and-Favicons/favicon.svg
!/ClickChat-Brand-Identity/ClickChat-Brand-Identity/04-Patterns/
